{
  "model": "sonnet",
  "effortLevel": "medium",
  "autoMemoryEnabled": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/after-edit.mjs"],
            "timeout": 45
          }
        ]
      }
    ]
  }
}
