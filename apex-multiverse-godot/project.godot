; Engine configuration file.
config_version=5

[application]

config/name="Apex Multiverse"
config/description="Apex Multiverse — 4 modos: Infinito, Historia, Camiones y Cohetes."
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.02, 0.03, 0.06, 1)
boot_splash/show_image=false
config/icon="res://assets/icon.png"

[autoload]

Game="*res://scripts/core/game.gd"
World="*res://scripts/world/world_data.gd"
Sfx="*res://scripts/core/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/fonts/Rajdhani-SemiBold.woff2"

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="DEFAULT"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.06, 1)

[shader_globals]

game_time={
"type": "float",
"value": 0.0
}
night={
"type": "float",
"value": 0.0
}
wet={
"type": "float",
"value": 0.0
}
